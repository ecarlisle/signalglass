{
  "$schema": "https://json.schemastore.org/fallowrc.json",
  "entry": ["scripts/validate-evidence-examples.mjs", "scripts/verify-projection-matrix.mjs"],
  "ignorePatterns": [".pi/**", ".signalglass/**"],
  "rules": {
    "unused-files": "error",
    "unused-dependencies": "warn",
    "unresolved-imports": "warn",
    "unlisted-dependencies": "off"
  }
}
